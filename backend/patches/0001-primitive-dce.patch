@@ -957,3 +981,132 @@ Proof
   drule comp_correct >>
   fs []
 QED
+
+
+(* -------------------------------------------------------------------------
+   Why shrink does not eliminate ShMem, and why its live-in set is exact.
+
+   loop_live performs dead-code elimination for Assign, LocValue and
+   Primitive: those write their lhs and do nothing else, so a dead lhs makes
+   the whole statement dead. ShMem looks superficially similar -- a load also
+   just writes its lhs -- but it is an external interaction: sh_mem_load and
+   sh_mem_store both go through
+
+     call_FFI s.ffi (SharedMem MappedRead) / (SharedMem MappedWrite) ...
+
+   and call_FFI appends an IO_event to st.io_events on every successful call,
+   advances st.ffi_state, and may instead answer Oracle_final, in which case
+   ShMem evaluates to SOME (FinalFFI outcome). The only no-op branch of
+   call_FFI is guarded by s = ExtCall <<>>, which no SharedMem ffiname
+   satisfies, so the event is unconditional. The oracle is a parameter of the
+   semantics, so it cannot be assumed pure either.
+
+   Each theorem below exhibits a counterexample to exactly the obligation
+   that a proposed strengthening of the ShMem case of shrink would have to
+   discharge inside compile_correct -- each is the (∃¬) form of the negation
+   of that obligation, so it rules the strengthening out. They share one
+   witness state whose oracle is the identity: it returns the bytes it was
+   handed, so call_FFI takes the FFI_return branch and the source run
+   succeeds with res = NONE. The counterexamples therefore do not lean on a
+   failing or diverging oracle, nor on the res ≠ SOME Error side condition.
+   ------------------------------------------------------------------------- *)
+
+Definition shmem_witness_def:
+  shmem_witness (s:('a,'ffi) loopSem$state) =
+    s with
+      <| locals     := insert 0 (Word 0w) (insert 1 (Word 0w) LN)
+       ; sh_mdomain := UNIV
+       ; ffi        := <| oracle    := (λn st conf bytes. Oracle_return st bytes)
+                        ; ffi_state := s.ffi.ffi_state
+                        ; io_events := [] |>
+       |>
+End
+
+(* The witness load runs without error, yet its observable trace grows: this
+   is the whole reason ShMem cannot be treated as dead code. *)
+Theorem shmem_witness_evaluates:
+  ∀s0:('a,'ffi) loopSem$state.
+    ∃s1.
+      evaluate (ShMem Load8 0 (Var 1), shmem_witness s0) = (NONE,s1) ∧
+      s1.ffi.io_events ≠ (shmem_witness s0).ffi.io_events
+Proof
+  rw [] >>
+  simp [evaluate_def, eval_def, shmem_witness_def,
+        loop_callTheory.is_load_def, sh_mem_op_def, sh_mem_load_def,
+        ffiTheory.call_FFI_def, set_var_def, lookup_insert, lookup_def]
+QED
+
+val shmem_ev_simps =
+  [evaluate_def, eval_def, shmem_witness_def, loop_callTheory.is_load_def,
+   sh_mem_op_def, sh_mem_load_def, ffiTheory.call_FFI_def, set_var_def,
+   subspt_lookup, lookup_insert, lookup_inter, lookup_def];
+
+(* 1. ShMem is not dead code: shrink may not return Skip for it. Stated for
+      *every* live-in set l1, so it rules out every DCE variant at once, no
+      matter which live-in set that variant would return: the witness hands
+      the compiled program the same locals as the source (locals := s.locals,
+      which satisfies subspt (inter s.locals l1) locals for all l1). So
+      nothing here can be blamed on liveness being too aggressive -- the
+      states differ in a component that is not locals, namely ffi.io_events. *)
+Theorem shmem_dce_unsound:
+  ∀l1. ∃(op:memop) v ad (s:('a,'ffi) loopSem$state) res s1 locals.
+    evaluate (ShMem op v ad,s) = (res,s1) ∧ res ≠ SOME Error ∧
+    subspt (inter s.locals l1) locals ∧
+    ∀new_locals.
+      evaluate (Skip, s with locals := locals) ≠
+        (res, s1 with locals := new_locals)
+Proof
+  gen_tac >>
+  qexistsl [‘Load8’,‘0’,‘Var 1’,‘shmem_witness ARB’,
+            ‘FST (evaluate (ShMem Load8 0 (Var 1), shmem_witness ARB))’,
+            ‘SND (evaluate (ShMem Load8 0 (Var 1), shmem_witness ARB))’,
+            ‘(shmem_witness ARB).locals’] >>
+  simp shmem_ev_simps >>
+  simp [state_component_equality] >>
+  simp [AllCaseEqs()] >>
+  metis_tac []
+QED
+
+(* 2. The `insert r ()` may not be dropped from the live-in set when the lhs
+      is dead in the live-out set -- the shape the old commented-out sketch
+      (`case lookup r l of NONE => l | ...`) would have produced. A shared
+      memory load existence-checks its lhs in locals *before* overwriting it,
+      so a live-in set that omits the lhs turns a successful run into an
+      Error. (Consequently there is no precision to recover here: r is
+      live-in whether or not it is live-out, and liveness tracks exactly
+      presence in locals, so `insert r ()` is already exact.) *)
+Theorem shmem_lhs_must_stay_live:
+  ∃(op:memop) v ad (s:('a,'ffi) loopSem$state) res s1 l locals.
+    evaluate (ShMem op v ad,s) = (res,s1) ∧ res ≠ SOME Error ∧
+    lookup v l = NONE ∧
+    subspt (inter s.locals (vars_of_exp ad l)) locals ∧
+    ∀new_locals.
+      evaluate (ShMem op v ad, s with locals := locals) ≠
+        (res, s1 with locals := new_locals)
+Proof
+  qexistsl [‘Load8’,‘0’,‘Var 1’,‘shmem_witness ARB’,
+            ‘FST (evaluate (ShMem Load8 0 (Var 1), shmem_witness ARB))’,
+            ‘SND (evaluate (ShMem Load8 0 (Var 1), shmem_witness ARB))’,
+            ‘LN’,
+            ‘inter (shmem_witness ARB).locals (vars_of_exp (Var 1) LN)’] >>
+  simp (vars_of_exp_def :: shmem_ev_simps)
+QED
+
+(* 3. The `vars_of_exp ad` may not be dropped from the live-in set either --
+      the other half of what the old sketch discarded. The address
+      expression is evaluated, so its variables are genuinely read. *)
+Theorem shmem_addr_must_stay_live:
+  ∃(op:memop) v ad (s:('a,'ffi) loopSem$state) res s1 l locals.
+    evaluate (ShMem op v ad,s) = (res,s1) ∧ res ≠ SOME Error ∧
+    subspt (inter s.locals (insert v () l)) locals ∧
+    ∀new_locals.
+      evaluate (ShMem op v ad, s with locals := locals) ≠
+        (res, s1 with locals := new_locals)
+Proof
+  qexistsl [‘Load8’,‘0’,‘Var 1’,‘shmem_witness ARB’,
+            ‘FST (evaluate (ShMem Load8 0 (Var 1), shmem_witness ARB))’,
+            ‘SND (evaluate (ShMem Load8 0 (Var 1), shmem_witness ARB))’,
+            ‘LN’,
+            ‘inter (shmem_witness ARB).locals (insert 0 () LN)’] >>
+  simp shmem_ev_simps
+QED
