/-- The functions with their certificates. -/
def fnsC : List FnC :=
  ((DN.Server.Session.functions.map lowerFn).zip certs).map fun ((f, ps, b), k) => (f, ps, b, k)

/-- …which are the program's functions as they lower. -/
theorem fnsC_lowers :
    fnsC.map (fun g => (g.1, g.2.1, g.2.2.1)) = DN.Server.Session.functions.map lowerFn := by
  unfold fnsC
  rw [List.map_map]
  exact List.map_fst_zip (by decide +kernel)

