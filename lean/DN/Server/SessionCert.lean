theorem fn_222_checked :
    (fnOkAt size [] fnsC 222 && (fnClaims size [] fnsC 222).length == 157) = true := by
  decide +kernel

theorem fn_222_count : (fnClaims size [] fnsC 222).length = 157 := by
  have h := fn_222_checked
  simp only [Bool.and_eq_true, beq_iff_eq] at h
  exact h.2

theorem fn_222_0 :
    (List.range' 0 82).all (fun j => ((fnClaims size [] fnsC 222).getD j default).ok size) = true := by
  decide +kernel

theorem fn_222_82 :
    (List.range' 82 75).all (fun j => ((fnClaims size [] fnsC 222).getD j default).ok size) = true := by
  decide +kernel

theorem fn_222 : ∀ j, j < (fnClaims size [] fnsC 222).length → ((fnClaims size [] fnsC 222).getD j default).ok size = true := by
  intro j hj
  rw [fn_222_count] at hj
  by_cases h0 : j < 82
  · exact all_range fn_222_0 j (by omega) (by omega)
  by_cases h82 : j < 157
  · exact all_range fn_222_82 j (by omega) (by omega)
  exact absurd hj (by omega)

/-- Each function's certificate fits it, and its claims hold. -/
theorem fns_each :
    ∀ i, i < fnsC.length →
      fnOkAt size [] fnsC i = true ∧ ObsOk size (fnClaims size [] fnsC i) := by
  intro i hi
  rw [fns_count] at hi
  by_cases h0 : i < 13
  · exact fnChecks_range group_0 i (by omega) (by omega)
  by_cases h13 : i < 72
  · exact fnChecks_range group_13 i (by omega) (by omega)
  by_cases h72 : i < 100
  · exact fnChecks_range group_72 i (by omega) (by omega)
  by_cases h100 : i < 127
  · exact fnChecks_range group_100 i (by omega) (by omega)
  by_cases h127 : i < 170
  · exact fnChecks_range group_127 i (by omega) (by omega)
  by_cases h170 : i < 182
  · exact fnChecks_range group_170 i (by omega) (by omega)
  by_cases h182 : i < 195
  · exact fnChecks_range group_182 i (by omega) (by omega)
  by_cases h195 : i < 205
  · exact fnChecks_range group_195 i (by omega) (by omega)
  by_cases h205 : i < 213
  · exact fnChecks_range group_205 i (by omega) (by omega)
  by_cases h213 : i < 222
  · exact fnChecks_range group_213 i (by omega) (by omega)
  by_cases h222 : i < 223
  · obtain rfl : i = 222 := by omega
    have h := fn_222_checked
    simp only [Bool.and_eq_true] at h
    exact ⟨h.1, obsOk_of_get fn_222⟩
  exact absurd hi (by omega)

theorem fns_ok : fnsOk size [] fnsC = true :=
  fnsOk_of_each fun i hi => (fns_each i hi).1

theorem fns_claims : ∀ i, i < fnsC.length → ObsOk size (fnClaims size [] fnsC i) :=
  fun i hi => (fns_each i hi).2

/-- The certificate fits `main`, and how many claims it makes. -/
theorem checked :
    ((checkC size mainP cert (envAfter [] fnsC)).toBool && (claims size mainP cert (envAfter [] fnsC)).length == 125) = true := by
  decide +kernel

theorem accepted : (checkC size mainP cert (envAfter [] fnsC)).toBool = true := by
  have h := checked
  simp only [Bool.and_eq_true] at h
  exact h.1

theorem count : (claims size mainP cert (envAfter [] fnsC)).length = 125 := by
  have h := checked
  simp only [Bool.and_eq_true, beq_iff_eq] at h
  exact h.2

theorem claims_ok_0 :
    (List.range' 0 68).all (fun j => ((claims size mainP cert (envAfter [] fnsC)).getD j default).ok size) = true := by
