export fun dn_crc32c(1 t, 1 p, 1 n) {
  var r = 0;
  var i = 0;
  var c = 0;
  var acc = 0;
  i = 0;
  while i < 256 {
    c = i;
    c = ((c) >>> 1) ^ (2197175160 & (0 - (c & 1)));
    c = ((c) >>> 1) ^ (2197175160 & (0 - (c & 1)));
    c = ((c) >>> 1) ^ (2197175160 & (0 - (c & 1)));
    c = ((c) >>> 1) ^ (2197175160 & (0 - (c & 1)));
    c = ((c) >>> 1) ^ (2197175160 & (0 - (c & 1)));
    c = ((c) >>> 1) ^ (2197175160 & (0 - (c & 1)));
    c = ((c) >>> 1) ^ (2197175160 & (0 - (c & 1)));
    c = ((c) >>> 1) ^ (2197175160 & (0 - (c & 1)));
    st t + (i * 8), c;
    i = i + 1;
  }
  i = 0;
  acc = 4294967295;
  while i < n {
    acc = (lds 1 (t + (((acc ^ (ld8 (p + i))) & 255) * 8))) ^ ((acc) >>> 8);
    i = i + 1;
  }
  r = acc ^ 4294967295;
  return r;
}
